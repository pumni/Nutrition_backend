{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nutrition.local/schemas/parsed-meal-0.1.0.json",
  "title": "Parsed meal document",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "items", "warnings"],
  "properties": {
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_text",
          "food_phrase",
          "quantity",
          "unit_phrase",
          "modifiers"
        ],
        "properties": {
          "source_text": {"type": "string", "minLength": 1, "maxLength": 500},
          "food_phrase": {"type": "string", "minLength": 1, "maxLength": 200},
          "quantity": {
            "type": ["number", "null"],
            "exclusiveMinimum": 0
          },
          "unit_phrase": {"type": ["string", "null"], "maxLength": 64},
          "modifiers": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "maxLength": 100}
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "maxLength": 200}
    }
  }
}

