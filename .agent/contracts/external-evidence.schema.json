{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/schemas/external-evidence.schema.json",
  "title": "Trusted External Gate Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "gate", "evidence_kind", "subject_commit", "result", "artifact_ref", "artifact_sha256", "issuer"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "gate": {"type": "string", "minLength": 1},
    "evidence_kind": {"type": "string", "minLength": 1},
    "subject_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "result": {"enum": ["pass", "waived"]},
    "artifact_ref": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "issuer": {"type": "string", "minLength": 1},
    "mode": {"enum": ["benchmark_pass", "owner_waiver"]},
    "waiver_ref": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "waived"}}, "required": ["result"]},
      "then": {
        "required": ["mode", "waiver_ref"],
        "properties": {"mode": {"const": "owner_waiver"}}
      }
    }
  ]
}
