{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "task_id",
    "baseline_sha",
    "target_sha",
    "control_sha",
    "task_spec_sha256",
    "verification_report_sha256",
    "verification_report_path",
    "result",
    "runner_release",
    "verifier_release",
    "verification_registry_release",
    "ci_release"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "release": {"const": "agent-ci-attestation-2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "baseline_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "target_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "control_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "task_spec_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "verification_report_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "verification_report_path": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "blocked"]},
    "runner_release": {"const": "agent-runner-2.0.0"},
    "verifier_release": {"const": "agent-verifier-3.0.0"},
    "verification_registry_release": {"const": "agent-gates-3.0.0"},
    "ci_release": {"const": "agent-ci-2.0.0"}
  }
}
