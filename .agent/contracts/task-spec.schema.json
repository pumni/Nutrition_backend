{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/schemas/task-spec.schema.json",
  "title": "Compiled Task Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "objective", "acceptance_criteria", "non_negotiables", "risk_level", "scope_envelope", "approved_protected_decisions", "baseline"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "non_negotiables": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_level": {"enum": ["low", "medium", "high", "critical"]},
    "scope_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude", "approved_protected_paths"],
      "properties": {
        "include": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclude": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "approved_protected_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "approved_protected_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "decision_id", "approval_ref", "scope"],
        "properties": {
          "domain": {"enum": ["product_domain_behavior", "architectural_boundary", "public_api_contract", "database_migration_intent", "security_privacy_policy", "llm_provider_boundary", "behavior_version_semantics", "production_provider_infrastructure", "canonical_publication", "release_policy", "architecturally_significant_dependency_changes"]},
          "decision_id": {"type": "string", "minLength": 1},
          "approval_ref": {"type": "string", "minLength": 1},
          "scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "source"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "source": {"const": "git"}
      }
    }
  }
}
