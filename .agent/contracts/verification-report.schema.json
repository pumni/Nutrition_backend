{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/schemas/verification-report.schema.json",
  "title": "Task Spec Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_spec_sha256", "releases", "control_plane", "target", "change_records", "derived_context_modules", "derived_risk_tags", "gate_results", "risk", "scope", "result"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_spec_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "releases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_release", "verifier_release", "verification_registry_release"],
      "properties": {
        "runner_release": {"type": "string", "minLength": 1},
        "verifier_release": {"type": "string", "minLength": 1},
        "verification_registry_release": {"type": "string", "minLength": 1}
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "head_commit", "file_hashes"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "head_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "file_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "baseline_commit", "head_commit"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "baseline_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "change_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "type": {"enum": ["create", "modify", "delete"]}
        }
      }
    },
    "derived_context_modules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "derived_risk_tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "kind", "required", "status", "exit_code", "output_byte_count", "output_sha256", "summary"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["pass", "fail", "skipped", "blocked"]},
          "exit_code": {"type": "integer"},
          "output_byte_count": {"type": "integer", "minimum": 0},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "effective", "escalated", "evidence_refs"],
      "properties": {
        "requested": {"enum": ["low", "medium", "high", "critical"]},
        "effective": {"enum": ["low", "medium", "high", "critical"]},
        "escalated": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "create", "modify", "delete", "violations"],
      "properties": {
        "result": {"enum": ["pass", "fail"]},
        "create": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "modify": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "delete": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "violations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "result": {"enum": ["pass", "fail", "blocked"]}
  }
}
