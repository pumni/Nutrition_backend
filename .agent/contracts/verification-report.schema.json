{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/schemas/verification-report.schema.json",
  "title": "Task Verification Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_packet_sha256", "releases", "control_plane", "target", "change_records", "gate_results", "scope", "impacts", "result"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_packet_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "releases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_release", "verifier_release", "verification_registry_release"],
      "properties": {
        "runner_release": {"type": "string", "minLength": 1},
        "verifier_release": {"type": "string", "minLength": 1},
        "verification_registry_release": {"type": "string", "minLength": 1}
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "head_commit", "file_hashes"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "head_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "file_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "baseline_commit", "head_commit"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "baseline_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "head_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "change_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "provenance"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "type": {"enum": ["create", "modify", "delete"]},
          "provenance": {"type": "array", "items": {"enum": ["committed", "staged", "unstaged", "untracked"]}}
        }
      }
    },
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "kind", "required", "status", "exit_code", "output_byte_count", "output_sha256", "summary"],
        "properties": {
          "gate": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "status": {"enum": ["pass", "fail", "skipped", "blocked"]},
          "exit_code": {"type": "integer"},
          "output_byte_count": {"type": "integer", "minimum": 0},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "create", "modify", "delete"],
      "properties": {
        "result": {"enum": ["pass", "fail"]},
        "create": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "modify": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "delete": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "impacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_behavior", "domain_behavior", "api", "database", "dependencies", "behavior_versions"],
      "properties": {
        "runtime_behavior": {"enum": ["none", "specified_change"]},
        "domain_behavior": {"enum": ["none", "specified_change"]},
        "api": {"enum": ["none", "specified_change"]},
        "database": {"enum": ["none", "specified_change"]},
        "dependencies": {"enum": ["none", "specified_change"]},
        "behavior_versions": {"enum": ["none", "specified_change"]}
      }
    },
    "result": {"enum": ["pass", "fail", "blocked"]}
  }
}
