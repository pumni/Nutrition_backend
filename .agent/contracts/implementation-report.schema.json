{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/schemas/implementation-report.schema.json",
  "title": "Implementation Report with Canonical Verification References",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "result", "scope_summary", "changed_files", "acceptance_criteria", "verification", "verification_report", "impacts", "deviations", "blockers"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "result": {"enum": ["pass", "fail", "blocked"]},
    "scope_summary": {"type": "string", "minLength": 1},
    "changed_files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "modified", "deleted"],
      "properties": {
        "created": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "modified": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "deleted": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "blocked"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "evidence_ref"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "skipped", "blocked"]},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "verification_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_release", "result", "sha256", "location_reference"],
      "properties": {
        "runner_release": {"const": "agent-runner-2.0.0"},
        "result": {"enum": ["pass", "fail", "blocked"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "location_reference": {"type": "string", "minLength": 1}
      }
    },
    "impacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_behavior", "domain_behavior", "api", "database", "dependencies", "behavior_versions"],
      "properties": {
        "runtime_behavior": {"enum": ["none", "specified_change"]},
        "domain_behavior": {"enum": ["none", "specified_change"]},
        "api": {"enum": ["none", "specified_change"]},
        "database": {"enum": ["none", "specified_change"]},
        "dependencies": {"enum": ["none", "specified_change"]},
        "behavior_versions": {"enum": ["none", "specified_change"]}
      }
    },
    "deviations": {"type": "array", "items": {"type": "string"}},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
