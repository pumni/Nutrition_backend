{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/schemas/agent-plan.schema.json",
  "title": "Agent-Owned Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_spec_sha256", "baseline", "observations", "hypothesis", "planned_changes", "expected_affected_paths", "implementation_steps", "verification_strategy", "risks", "protected_decisions_required", "status"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_spec_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "source"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
        "source": {"const": "git"}
      }
    },
    "observations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "hypothesis": {"type": "string", "minLength": 1},
    "planned_changes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_affected_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "implementation_steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "verification_strategy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "protected_decisions_required": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["draft", "in_progress", "blocked", "complete"]}
  }
}
