{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/schemas/execution-state.schema.json",
  "title": "Durable Agent Execution State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_spec_sha256", "baseline_commit", "head_commit", "plan_sha256", "discoveries", "progress", "verification_references", "protected_decision_blockers", "status"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "task_spec_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "baseline_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "head_commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "discoveries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "progress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pending", "in_progress", "complete", "blocked"]},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "verification_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate_id", "status", "evidence_ref"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "skipped", "blocked"]},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "protected_decision_blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "risk_escalations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk_level", "reason", "evidence_refs"],
        "properties": {
          "risk_level": {"enum": ["low", "medium", "high", "critical"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "status": {"enum": ["not_started", "in_progress", "blocked", "complete"]}
  }
}
