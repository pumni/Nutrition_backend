{
  "schema_version": "2.0.0",
  "budget_policy": {
    "per_file_limit_source": "manifest.budgets.context_file_max_bytes",
    "preserve_per_file_limit": true,
    "max_modules_per_task": 10
  },
  "modules": [
    {
      "name": "base-policy",
      "context_files": [".agent/authority/execution-contract.md", ".agent/authority/decision-policy.md", ".agent/invariants/architecture.md", ".agent/invariants/security-privacy.md", ".agent/policies/crate-boundaries.json", ".agent/policies/change-impact-policy.json", ".agent/generated/crate-graph.json", ".agent/maps/verification-map.json"],
      "mandatory_gates": ["acl-integrity", "foundation-verify"],
      "risk_tags": ["authority", "architecture", "security"]
    },
    {
      "name": "verification",
      "context_files": [".agent/contexts/verification.md"],
      "mandatory_gates": ["acl-integrity", "foundation-verify"],
      "risk_tags": ["verification", "freshness", "scope"]
    },
    {
      "name": "domain",
      "context_files": [".agent/invariants/product-domain.md", ".agent/invariants/data-replay.md", ".agent/contexts/domain.md"],
      "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"],
      "risk_tags": ["calculation", "domain-boundary"]
    },
    {
      "name": "application",
      "context_files": [".agent/invariants/product-domain.md", ".agent/invariants/data-replay.md", ".agent/contexts/application.md"],
      "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"],
      "risk_tags": ["orchestration", "revisions", "clarification"]
    },
    {
      "name": "parser",
      "context_files": [".agent/invariants/llm-boundary.md", ".agent/contexts/parser.md"],
      "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test", "schema-validation"],
      "risk_tags": ["provider", "privacy", "parser"]
    },
    {
      "name": "persistence",
      "context_files": [".agent/invariants/data-replay.md", ".agent/contexts/persistence.md"],
      "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test", "postgres-verify"],
      "risk_tags": ["database", "replay", "immutability"]
    },
    {
      "name": "api",
      "context_files": [".agent/contexts/api.md", ".agent/contexts/application.md"],
      "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"],
      "risk_tags": ["api", "auth", "privacy"]
    },
    {
      "name": "worker",
      "context_files": [".agent/contexts/worker.md", ".agent/contexts/persistence.md"],
      "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"],
      "risk_tags": ["lease", "retry", "outbox"]
    },
    {
      "name": "data-governance",
      "context_files": [".agent/invariants/data-replay.md", ".agent/contexts/data-governance.md"],
      "mandatory_gates": ["foundation-verify"],
      "risk_tags": ["test-only-evidence", "benchmark", "release"]
    },
    {
      "name": "agent-context-maintenance",
      "context_files": [".agent/contexts/verification.md"],
      "mandatory_gates": ["acl-self-test", "agent-runner-self-test", "agent-ci-policy", "acl-integrity", "foundation-verify"],
      "risk_tags": ["governance", "context-drift", "scope-control"]
    }
  ],
  "presets": [
    {"name": "base", "modules": ["base-policy", "verification"]},
    {"name": "domain-calculation", "modules": ["base-policy", "domain"]},
    {"name": "application-analysis", "modules": ["base-policy", "application"]},
    {"name": "parser-hosted", "modules": ["base-policy", "parser"]},
    {"name": "persistence-postgres", "modules": ["base-policy", "persistence"]},
    {"name": "api-http", "modules": ["base-policy", "api"]},
    {"name": "worker-ops", "modules": ["base-policy", "worker"]},
    {"name": "data-governance", "modules": ["base-policy", "data-governance"]},
    {"name": "agent-context-maintenance", "modules": ["base-policy", "verification", "agent-context-maintenance"]}
  ]
}
