{
  "schema_version": "1.0.0",
  "presets_ref": ".agent/context/presets.json",
  "base_modules": ["base-policy", "verification"],
  "path_routes": [
    {"path_pattern": "crates/domain/**", "modules": ["domain"], "risk_tags": ["calculation", "domain-boundary"], "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"]},
    {"path_pattern": "crates/application/**", "modules": ["application"], "risk_tags": ["orchestration", "revisions", "clarification"], "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"]},
    {"path_pattern": "crates/adapters/src/hosted_parser.rs", "modules": ["parser"], "risk_tags": ["provider", "privacy", "parser"], "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test", "schema-validation"]},
    {"path_pattern": "schemas/**", "modules": ["parser"], "risk_tags": ["parser-contract", "versioning"], "mandatory_gates": ["schema-validation", "cargo-test"]},
    {"path_pattern": "crates/persistence-postgres/**", "modules": ["persistence"], "risk_tags": ["database", "replay", "immutability"], "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test", "postgres-verify"]},
    {"path_pattern": "migrations/**", "modules": ["persistence"], "risk_tags": ["database", "migration"], "mandatory_gates": ["postgres-verify"]},
    {"path_pattern": "crates/api-http/**", "modules": ["api", "application"], "risk_tags": ["api", "auth", "privacy"], "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"]},
    {"path_pattern": "crates/worker/**", "modules": ["worker", "persistence"], "risk_tags": ["lease", "retry", "outbox"], "mandatory_gates": ["cargo-fmt", "cargo-clippy", "cargo-test"]},
    {"path_pattern": "fixtures/**", "modules": ["data-governance"], "risk_tags": ["test-only-evidence", "benchmark"], "mandatory_gates": ["foundation-verify"]},
    {"path_pattern": "seeds/**", "modules": ["data-governance"], "risk_tags": ["release", "catalog"], "mandatory_gates": ["foundation-verify", "postgres-verify"]},
    {"path_pattern": ".agent/**", "modules": ["agent-context-maintenance"], "risk_tags": ["governance", "context-drift"], "mandatory_gates": ["acl-self-test", "agent-runner-self-test", "agent-ci-policy", "acl-integrity", "foundation-verify"]},
    {"path_pattern": "AGENTS.md", "modules": ["agent-context-maintenance"], "risk_tags": ["governance", "entrypoint"], "mandatory_gates": ["acl-integrity", "foundation-verify"]},
    {"path_pattern": "scripts/**", "modules": ["agent-context-maintenance"], "risk_tags": ["verification", "governance"], "mandatory_gates": ["acl-integrity", "foundation-verify"]}
  ],
  "risk_routes": [
    {"risk_level": "investigation", "modules": ["verification"], "mandatory_gates": ["acl-integrity"]},
    {"risk_level": "normal_internal", "modules": [], "mandatory_gates": []},
    {"risk_level": "boundary_sensitive", "modules": ["verification"], "mandatory_gates": ["acl-integrity"]},
    {"risk_level": "protected_decision", "modules": ["verification"], "mandatory_gates": ["acl-integrity"]}
  ],
  "legacy_profile_aliases": {
    "core": "base",
    "domain-calculation": "domain-calculation",
    "application-analysis": "application-analysis",
    "parser-hosted": "parser-hosted",
    "persistence-postgres": "persistence-postgres",
    "api-http": "api-http",
    "worker-ops": "worker-ops",
    "data-governance": "data-governance",
    "agent-context-maintenance": "agent-context-maintenance"
  },
  "expansion_policy": {
    "allow_additional_modules": true,
    "requires_repository_evidence": true,
    "reject_unrelated_context": true,
    "max_modules": 10,
    "preserve_module_budgets": true
  }
}
