    },
    {
      "name": "persistence-postgres",
      "path": "crates/persistence-postgres",
      "role": "PostgreSQL repositories, telemetry, jobs, outbox, and seed support",
      "key_files": ["crates/persistence-postgres/src/lib.rs", "crates/persistence-postgres/src/analysis_repository.rs", "crates/persistence-postgres/src/catalog_repository.rs", "crates/persistence-postgres/src/portion_repository.rs", "crates/persistence-postgres/src/parser_telemetry.rs", "crates/persistence-postgres/src/ops_repository.rs", "crates/persistence-postgres/tests/postgres_integration.rs"],
      "upstream_dependencies": ["application", "domain"],
      "forbidden_dependencies": ["edited applied migrations", "unversioned replay dependencies"],
      "relevant_context_profile": "persistence-postgres"
    },
    {
      "name": "api-http",
      "path": "crates/api-http",
