      "relevant_context_profile": "domain-calculation"
    },
    {
      "name": "application",
      "path": "crates/application",
      "role": "analysis orchestration, ports, revisions, clarification, and correction",
      "key_files": ["crates/application/src/lib.rs", "crates/application/src/analyze.rs", "crates/application/src/revise.rs", "crates/application/src/model.rs", "crates/application/src/ports.rs", "crates/application/src/normalization.rs"],
      "upstream_dependencies": ["domain"],
      "forbidden_dependencies": ["axum", "sqlx", "tokio", "provider SDKs"],
      "relevant_context_profile": "application-analysis"
    },
    {
      "name": "adapters",
      "path": "crates/adapters",
      "role": "fixture catalog/parser and hosted parser transport adapter",
      "key_files": ["crates/adapters/src/lib.rs", "crates/adapters/src/fixture.rs", "crates/adapters/src/hosted_parser.rs"],
      "upstream_dependencies": ["application", "domain"],
      "forbidden_dependencies": ["nutrition facts generated by the model", "silent fixture fallback"],
