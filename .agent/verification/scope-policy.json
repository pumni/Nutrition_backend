{
  "schema_version": "2.0.0",
  "protected_path_patterns": [
    "Cargo.toml",
    "Cargo.lock",
    "crates/*/Cargo.toml",
    "migrations/**",
    "deploy/**",
    ".github/workflows/**",
    ".agent/authority/**",
    ".agent/invariants/**",
    ".agent/context/**",
    ".agent/verification/**",
    ".agent/maps/**",
    ".agent/contracts/**",
    "AGENTS.md",
    "docs/AGENT_ENGINEERING.md",
    "scripts/prepare-agent-task.ps1",
    "scripts/compile-agent-task-spec.ps1",
    "scripts/run-agent-verification.ps1",
    "scripts/verify-agent-context.ps1",
    "scripts/verify-postgres.ps1",
    "crates/api-http/src/main.rs",
    "schemas/**"
  ],
  "approval_source": "task_spec.scope_envelope.approved_protected_paths",
  "protected_scope_requires_approval": true
}
