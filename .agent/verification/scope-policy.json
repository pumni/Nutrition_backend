{
  "schema_version": "2.0.0",
  "protected_path_patterns": [
    "Cargo.toml",
    "Cargo.lock",
    "migrations/**",
    "deploy/**",
    ".github/workflows/**",
    ".agent/authority/**",
    ".agent/invariants/**"
  ],
  "approval_source": "task_spec.scope_envelope.approved_protected_paths",
  "risk_levels": ["low", "medium", "high", "critical"],
  "authorization_states": ["unprotected", "approved_protected_change", "requires_human_decision"],
  "exact_file_mode_risks": ["critical"]
}
