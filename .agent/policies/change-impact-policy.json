{
  "schema_version": "2.0.0",
  "rules": [
    {"path_pattern": "crates/domain/**", "forbidden_impacts": ["network", "database", "provider-dependency", "unversioned-behavior"]},
    {"path_pattern": "crates/application/**", "forbidden_impacts": ["overwrite-completed-revision", "unversioned-behavior"]},
    {"path_pattern": "crates/adapters/src/hosted_parser.rs", "forbidden_impacts": ["nutrition-invention", "raw-telemetry", "fixture-fallback", "redirect-forwarding"]},
    {"path_pattern": "schemas/**", "forbidden_impacts": ["unversioned-parser-contract"]},
    {"path_pattern": "crates/persistence-postgres/**", "forbidden_impacts": ["weakened-immutability", "unversioned-replay"]},
    {"path_pattern": "migrations/**", "forbidden_impacts": ["edit-applied-migration", "schema-without-approval"]},
    {"path_pattern": "crates/api-http/**", "forbidden_impacts": ["ownership-bypass", "request-limit-weakening", "sensitive-logging"]},
    {"path_pattern": "crates/worker/**", "forbidden_impacts": ["unbounded-retry", "non-idempotent-side-effect"]},
    {"path_pattern": "fixtures/**", "forbidden_impacts": ["fixture-as-production", "unknown-force-match"]},
    {"path_pattern": "seeds/**", "forbidden_impacts": ["unreviewed-publication", "active-release-mutation"]},
    {"path_pattern": ".agent/**", "forbidden_impacts": ["runtime-behavior", "dependency-change", "database-change"]},
    {"path_pattern": "AGENTS.md", "forbidden_impacts": ["runtime-behavior", "dependency-change"]},
    {"path_pattern": "scripts/verify-agent-context.ps1", "forbidden_impacts": ["runtime-behavior", "dependency-change"]},
    {"path_pattern": "scripts/run-agent-verification.ps1", "forbidden_impacts": ["runtime-behavior", "dependency-change", "arbitrary-command-execution"]},
    {"path_pattern": ".github/workflows/**", "forbidden_impacts": ["runtime-behavior", "dependency-change", "capability-sandbox"]},
    {"path_pattern": "scripts/verify.ps1", "forbidden_impacts": ["weakened-foundation-gate"]}
  ]
}
